{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": false,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,
    // @testing-library/jest-native is deprecated and NOT installed. Listing it
    // here made tsc abort with TS2688 before checking a single file, which is
    // why type errors in the app went unnoticed. @testing-library/react-native
    // v13 ships the matchers natively, so only "jest" is needed.
    "types": ["jest"],
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", "src/**/*"],
  "exclude": ["node_modules", "e2e", "android", "ios", "website"]
}
