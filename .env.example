# Copy to `.env` for local development and set the real values in your CI /
# EAS secrets for release builds. `.env` itself is gitignored.
#
# Everything prefixed EXPO_PUBLIC_ is inlined into the JS bundle and is therefore
# READABLE BY ANYONE who downloads the app. Only publishable keys belong here.
# Never put a Sentry auth token, a Play service-account JSON or an App Store
# API key in this file — those go in CI secrets (see .github/workflows/ci.yml).

# --- Crash reporting -------------------------------------------------------
# Sentry DSN is a publishable key. Leave empty to disable crash reporting.
EXPO_PUBLIC_SENTRY_DSN=
# Set by CI to the release being built, e.g. com.dosagecalculator.app@1.0.0+1
EXPO_PUBLIC_RELEASE=
EXPO_PUBLIC_ENV=development

# --- In-app purchases (RevenueCat) ----------------------------------------
# Public SDK keys from RevenueCat → Project Settings → API keys.
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=

# --- Ads (AdMob) -----------------------------------------------------------
# Ad UNIT ids. The App ids live in app.json because the native manifest needs
# them at build time. Leaving a unit empty disables that ad slot rather than
# shipping a placeholder id that fails at runtime.
EXPO_PUBLIC_ADMOB_BANNER_IOS=
EXPO_PUBLIC_ADMOB_BANNER_ANDROID=
EXPO_PUBLIC_ADMOB_INTERSTITIAL_IOS=
EXPO_PUBLIC_ADMOB_INTERSTITIAL_ANDROID=
EXPO_PUBLIC_ADMOB_APPOPEN_IOS=
EXPO_PUBLIC_ADMOB_APPOPEN_ANDROID=
